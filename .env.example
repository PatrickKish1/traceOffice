# Optional. The office opens with none of these set.

# Grok session folder. Default is ~/.grok
# GROK_HOME=

# Project folder for local session reads.
# TRACE_SESSION_CWD=
# DOTS_SESSION_CWD=

# Ingest key for apps that send traces. TraceOffice does not read this.
# Public API reads need NEATLOGS_TOKEN, not this ingest key.
# NEATLOGS_API_KEY=
# NEATLOGS_PROJECT_ID=
# NEATLOGS_TOKEN=

# Worker origin when the page and the relay are on different hosts.
# VITE_LIVE_API_URL=

# Optional Python system-one triage for POST /api/jev/triage (dev server only).
# JEV_SYSTEM_ONE=1
# JEV_SYSTEM_ONE_PYTHON=python3
# JEV_SYSTEM_ONE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
